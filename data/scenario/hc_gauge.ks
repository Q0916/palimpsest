[anim name="hc2_light_right" left="&String(tf.ga2_g.light_right.left)" top="&String(tf.ga2_g.light_right.top)" width="&String(tf.ga2_g.light_right.width)" height="&String(tf.ga2_g.light_right.height)" opacity="&String(tf.ga2_g.light_right.opacity)" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:(tf.ga2_time))" effect="easeInOutCubic"]
[anim name="hc2_dark_body" left="&String(tf.ga2_g.dark_body.left)" top="&String(tf.ga2_g.dark_body.top)" width="&String(tf.ga2_g.dark_body.width)" height="&String(tf.ga2_g.dark_body.height)" opacity="&String(tf.ga2_g.dark_body.opacity)" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:(tf.ga2_time))" effect="easeInOutCubic"]
[anim name="hc2_dark_left" left="&String(tf.ga2_g.dark_left.left)" top="&String(tf.ga2_g.dark_left.top)" width="&String(tf.ga2_g.dark_left.width)" height="&String(tf.ga2_g.dark_left.height)" opacity="&String(tf.ga2_g.dark_left.opacity)" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:(tf.ga2_time))" effect="easeInOutCubic"]
[anim name="hc2_dark_right" left="&String(tf.ga2_g.dark_right.left)" top="&String(tf.ga2_g.dark_right.top)" width="&String(tf.ga2_g.dark_right.width)" height="&String(tf.ga2_g.dark_right.height)" opacity="&String(tf.ga2_g.dark_right.opacity)" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:(tf.ga2_time))" effect="easeInOutCubic"]
[anim name="hc2_head" left="&String(tf.ga2_g.head.left)" top="&String(tf.ga2_g.head.top)" width="&String(tf.ga2_g.head.width)" height="&String(tf.ga2_g.head.height)" opacity="&String(tf.ga2_g.head.opacity)" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:(tf.ga2_time))" effect="easeInOutCubic"]
