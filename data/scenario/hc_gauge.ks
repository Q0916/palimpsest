[macro name="hc2_focus"]
[if exp="!(sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip) && !f.hc_gauge_focus"]
[free layer="2" name="hc2_veil" time="0"]
[image layer="2" name="hc_gauge,hc2_veil" storage="&'hc/ga2/hee9d09008adb_veil.png?ga2='+String(++tf.ga2_seq)" time="0" left="0" top="0" width="1280" height="720" zindex="220"]
[anim name="hc2_veil" opacity="0" time="0"]
[wa]
[anim name="hc2_veil" opacity="255" time="600"]
[iscript]
f.hc_gauge_focus=true;
[endscript]
[hc_gauge_set time="700"]
[endif]
[endmacro]
[macro name="hc_gauge_glow"]
[if exp="!(sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)"]
[hc2_prepare]
[image layer="2" name="hc_gauge,hc2_glow" storage="&'hc/ga2/h2ce90a12ed80_glow_once.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_cx+((-6)-150)*tf.ga2_s)" top="&String(tf.ga2_cy+((40)-45)*tf.ga2_s)" width="&String((298*f.hc_gauge_value/100+18)*tf.ga2_s)" height="&String((44)*tf.ga2_s)" zindex="242"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(900))"]
[free layer="2" name="hc2_glow" time="0"]
[endif]
[endmacro]
[macro name="hc2_home"]
[iscript]
f.hc_gauge_focus=false;tf.ga2_zoom=1;tf.ga2_dx=0;tf.ga2_dy=0;
[endscript]
[anim name="hc2_veil" opacity="0" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:600)"]
[hc_gauge_set time="700"]
[free layer="2" name="hc2_veil" time="0"]
[free layer="2" name="hc2_glow" time="0"]
[free layer="2" name="hc2_black" time="0"]
[free layer="2" name="hc2_web" time="0"]
[free layer="2" name="hc2_shatter" time="0"]
[free layer="2" name="hc2_flash" time="0"]
[free layer="2" name="hc2_pressure" time="0"]
[if exp="sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip"]
[stopse buf="6"]
[stopse buf="7"]
[endif]
[endmacro]
[macro name="hc_gauge_rise"]
[hc2_audio]
[iscript]
tf.ga2_rise=Number(mp.value||5);
[endscript]
[hc2_focus]
[if exp="!(sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)"]
[playse storage="hc/haba9b661511c_ga2_rise.mp3" buf="7" volume="65"]
[endif]
[hc_gauge_set value="&String(tf.ga2_rise)" time="1000"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(100))"]
[hc_gauge_glow]
[hc2_home]
[iscript]
f.hc_gauge_appeared=false;
[endscript]
[endmacro]
[macro name="hc_gauge_spike"]
[hc2_audio]
[iscript]
tf.ga2_spike={peak:Math.max(0,Math.min(100,Number(mp.peak)||65)),back:Math.max(0,Math.min(100,Number(mp.back)||0)),crack:mp.crack!=='false'};
[endscript]
[if exp="!f.hc_gauge_shown"]
[hc2_init]
[endif]
[if exp="sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip"]
[iscript]
f.hc_gauge_value=tf.ga2_spike.back;if(tf.ga2_spike.crack)f.hc_gauge_crackAt=tf.ga2_spike.peak;
[endscript]
[hc2_home]
[else]
[hc2_focus]
[playse storage="hc/h70f627191966_ga2_inhale.mp3" buf="7" volume="60"]
[hc_gauge_set value="&String(tf.ga2_spike.peak)" time="700"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(180))"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(Math.max(1,1100-(Date.now()-(tf.ga2_last_flash||0)))))"]
[if exp="!(sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)"]
[image layer="2" name="hc_gauge,hc2_black" storage="&'hc/ga2/hd2e4a1460f3f_shell_black.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.shell.left)" top="&String(tf.ga2_g.shell.top)" width="&String(tf.ga2_g.shell.width)" height="&String(tf.ga2_g.shell.height)" zindex="240"]
[image layer="2" name="hc_gauge,hc2_black" storage="&'hc/ga2/h8c57b006df7e_head_black.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.head.left)" top="&String(tf.ga2_g.head.top)" width="&String(tf.ga2_g.head.width)" height="&String(tf.ga2_g.head.height)" zindex="240"]
[image layer="2" name="hc_gauge,hc2_black" storage="&'hc/ga2/h7b1b68471f9d_fill_light_body_black.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.light_body.left)" top="&String(tf.ga2_g.light_body.top)" width="&String(tf.ga2_g.light_body.width)" height="&String(tf.ga2_g.light_body.height)" zindex="240"]
[image layer="2" name="hc_gauge,hc2_black" storage="&'hc/ga2/hf687ce2062da_fill_light_left_black.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.light_left.left)" top="&String(tf.ga2_g.light_left.top)" width="&String(tf.ga2_g.light_left.width)" height="&String(tf.ga2_g.light_left.height)" zindex="240"]
[image layer="2" name="hc_gauge,hc2_black" storage="&'hc/ga2/h982d3498b0df_fill_light_right_black.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.light_right.left)" top="&String(tf.ga2_g.light_right.top)" width="&String(tf.ga2_g.light_right.width)" height="&String(tf.ga2_g.light_right.height)" zindex="240"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(17))"]
[free layer="2" name="hc2_black" time="0"]
[image layer="2" name="hc_gauge,hc2_shatter" storage="&'hc/ga2/h20238a28b71d_shatter_once.png?ga2='+String(++tf.ga2_seq)" time="0" left="0" top="0" width="1280" height="720" zindex="225"]
[hc2_prepare]
[image layer="2" name="hc_gauge,hc2_web" storage="&'hc/ga2/hbc0a5e6f27f2_web_once.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_cx+((300*tf.ga2_spike.peak/100-70)-150)*tf.ga2_s)" top="&String(tf.ga2_cy+((-8)-45)*tf.ga2_s)" width="&String((140)*tf.ga2_s)" height="&String((140)*tf.ga2_s)" zindex="242"]
[playse storage="hc/h8c628e225619_ga2_glass_tick.mp3" buf="6" volume="70"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(420))"]
[playse storage="hc/h811b535ddb4b_ga2_glass_tick2.mp3" buf="6" volume="70"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(380))"]
[image layer="2" name="hc_gauge,hc2_flash" storage="&'hc/ga2/hd324f68de484_flash_once.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_cx+((-20)-150)*tf.ga2_s)" top="&String(tf.ga2_cy+((25)-45)*tf.ga2_s)" width="&String((340)*tf.ga2_s)" height="&String((90)*tf.ga2_s)" zindex="242"]
[playse storage="hc/ha9838a815d71_ga2_glass_crack.mp3" buf="6" volume="70"]
[iscript]
tf.ga2_last_flash=Date.now();
[endscript]
[iscript]
tf.ga2_dx=-6;tf.ga2_dy=2;
[endscript]
[hc_gauge_set time="90"]
[free layer="2" name="hc2_flash" time="0"]
[iscript]
tf.ga2_dx=4;tf.ga2_dy=-2;
[endscript]
[hc_gauge_set time="160"]
[iscript]
tf.ga2_dx=-2;tf.ga2_dy=1;
[endscript]
[hc_gauge_set time="80"]
[iscript]
tf.ga2_dx=0;tf.ga2_dy=0;
[endscript]
[hc_gauge_set time="110"]
[iscript]
tf.ga2_dx=0;tf.ga2_dy=0;
[endscript]
[hc_gauge_set time="220"]
[image layer="2" name="hc_gauge,hc2_pressure" storage="&'hc/ga2/h29408d7aba9e_pressure_once.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_cx+((-10)-150)*tf.ga2_s)" top="&String(tf.ga2_cy+((-36)-45)*tf.ga2_s)" width="&String((320)*tf.ga2_s)" height="&String((130)*tf.ga2_s)" zindex="242"]
[endif]
[hc_gauge_set value="&String(tf.ga2_spike.back)" time="260"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(20))"]
[iscript]
if(tf.ga2_spike.crack)f.hc_gauge_crackAt=tf.ga2_spike.peak;
[endscript]
[hc_gauge_set time="0"]
[anim name="hc2_web" opacity="0" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:600)"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(700))"]
[free layer="2" name="hc2_web" time="0"]
[free layer="2" name="hc2_shatter" time="0"]
[free layer="2" name="hc2_pressure" time="0"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(500))"]
[hc2_home]
[endif]
[endmacro]
[macro name="hc_gauge_twitch"]
[iscript]
tf.ga2_base=f.hc_gauge_value||0;tf.ga2_amount=mp.amount==null?4+5*Number(mp.attempt||0):Number(mp.amount);tf.ga2_ceiling=f.hc_gauge_crackAt==null?100:Math.max(tf.ga2_base,f.hc_gauge_crackAt-8);tf.ga2_target=Math.min(tf.ga2_base+tf.ga2_amount,tf.ga2_ceiling);
[endscript]
[if exp="!(sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)"]
[hc_gauge_set value="&String(tf.ga2_target)" time="180"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(20))"]
[hc_gauge_set value="&String(tf.ga2_base)" time="90"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(170))"]
[endif]
[endmacro]
[macro name="hc_gauge_repelled"]
[hc_gauge_twitch attempt="%attempt|1"]
[endmacro]
[macro name="hc_gauge_hide"]
[wait time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?1:(Number(mp.hold==null?1600:mp.hold)))"]
[free layer="2" name="hc_gauge" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:Number(mp.time||900))"]
[iscript]
f.hc_gauge_shown=false;f.hc_gauge_focus=false;f.hc_gauge_appeared=false;tf.ga2_zoom=1;tf.ga2_dx=0;tf.ga2_dy=0;
[endscript]
[stopse buf="6"]
[stopse buf="7"]
[endmacro]
[return]
