[image layer="2" name="hc_gauge,hc2_head" storage="&'hc/ga2/had775028194a_head.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.head.left)" top="&String(tf.ga2_g.head.top)" width="&String(tf.ga2_g.head.width)" height="&String(tf.ga2_g.head.height)" zindex="235"]
[image layer="2" name="hc_gauge,hc2_scar" storage="&'hc/ga2/hd83ca10efe4b_scar.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.scar.left)" top="&String(tf.ga2_g.scar.top)" width="&String(tf.ga2_g.scar.width)" height="&String(tf.ga2_g.scar.height)" zindex="238"]
[anim name="hc_gauge" opacity="0" time="0"]
[wa]
[layopt layer="2" visible="true"]
[endmacro]
[macro name="hc_gauge_set"]
