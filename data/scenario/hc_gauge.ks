[endscript]
[hc2_prepare]
[anim name="hc2_shell" left="&String(tf.ga2_g.shell.left)" top="&String(tf.ga2_g.shell.top)" width="&String(tf.ga2_g.shell.width)" height="&String(tf.ga2_g.shell.height)" opacity="&String(tf.ga2_g.shell.opacity)" time="&String((sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)?0:(tf.ga2_time))" effect="easeInOutCubic"]
