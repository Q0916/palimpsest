
[iscript]
tf.ga2_seq=tf.ga2_seq||0;
[endscript]
[macro name="hc2_audio"]
[if exp="!(sf.hc_reduce_motion || window.matchMedia('(prefers-reduced-motion: reduce)').matches || TYRANO.kag.stat.is_skip)"]
[preload storage="./data/sound/hc/haba9b661511c_ga2_rise.mp3" single_use="false" name="ga2_audio"]
[preload storage="./data/sound/hc/h70f627191966_ga2_inhale.mp3" single_use="false" name="ga2_audio"]
[preload storage="./data/sound/hc/h8c628e225619_ga2_glass_tick.mp3" single_use="false" name="ga2_audio"]
[preload storage="./data/sound/hc/h811b535ddb4b_ga2_glass_tick2.mp3" single_use="false" name="ga2_audio"]
[preload storage="./data/sound/hc/ha9838a815d71_ga2_glass_crack.mp3" single_use="false" name="ga2_audio"]
[wait_preload]
[endif]
[endmacro]
[macro name="hc2_prepare"]
[iscript]

var v=Math.max(0,Math.min(100,Number(f.hc_gauge_value)||0)),r=v/100;
var depth=Math.max(0,Math.min(1,(v-15)/35));
var reveal=v<=35?Math.max(0,(v-15)/20)*.6:.6+Math.min(1,(v-35)/30)*.4;
var hs=.4+reveal*.6,s=(f.hc_gauge_focus?1.6:2/3)*(tf.ga2_zoom||1);
var cx=(f.hc_gauge_focus?640:1148)+(tf.ga2_dx||0),cy=(f.hc_gauge_focus?316.666667:112.666667)+(tf.ga2_dy||0);
function box(x,y,w,h,a){return {left:cx+(x-150)*s,top:cy+(y-45)*s,width:Math.max(1,w*s),height:h*s,opacity:Math.round(a*255)};}
tf.ga2_g={shell:box(-20,-20,340,140,1),head:box(3+298*r-45*hs,62-48.5*hs,90*hs,97*hs,reveal),scar:box(300*(f.hc_gauge_crackAt||0)/100-14,37,28,50,f.hc_gauge_crackAt==null?0:1)};
var w=298*r,cap=Math.min(10,w/2);
for(var tone of ['light','dark']){var a=v>0?(tone==='light'?1:depth):0;tf.ga2_g[tone+'_left']=box(3,52,cap,20,a);tf.ga2_g[tone+'_body']=box(3+cap,52,Math.max(0,w-2*cap),20,w>2*cap?a:0);tf.ga2_g[tone+'_right']=box(3+w-cap,52,cap,20,a);}
tf.ga2_s=s;tf.ga2_cx=cx;tf.ga2_cy=cy;tf.ga2_reveal=reveal;

[endscript]
[endmacro]
[macro name="hc2_init"]
[hc2_audio]
[free layer="2" name="hc_gauge" time="0"]
[layopt layer="2" visible="false"]
[iscript]
f.hc_gauge_value=0;f.hc_gauge_crackAt=null;f.hc_gauge_focus=false;f.hc_gauge_shown=true;f.hc_gauge_appeared=false;tf.ga2_zoom=1;tf.ga2_dx=0;tf.ga2_dy=0;
[endscript]
[hc2_prepare]
[image layer="2" name="hc_gauge,fx_q,hc2_shell" storage="&'hc/ga2/h464fc3d52bf1_shell.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.shell.left)" top="&String(tf.ga2_g.shell.top)" width="&String(tf.ga2_g.shell.width)" height="&String(tf.ga2_g.shell.height)" zindex="230"]
[image layer="2" name="hc_gauge,hc2_light_body" storage="&'hc/ga2/h0b2df26aef4b_fill_light_body.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.light_body.left)" top="&String(tf.ga2_g.light_body.top)" width="&String(tf.ga2_g.light_body.width)" height="&String(tf.ga2_g.light_body.height)" zindex="232"]
[image layer="2" name="hc_gauge,hc2_light_left" storage="&'hc/ga2/h26d0c3b22570_fill_light_left.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.light_left.left)" top="&String(tf.ga2_g.light_left.top)" width="&String(tf.ga2_g.light_left.width)" height="&String(tf.ga2_g.light_left.height)" zindex="232"]
[image layer="2" name="hc_gauge,hc2_light_right" storage="&'hc/ga2/h472260a0bb99_fill_light_right.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.light_right.left)" top="&String(tf.ga2_g.light_right.top)" width="&String(tf.ga2_g.light_right.width)" height="&String(tf.ga2_g.light_right.height)" zindex="232"]
[image layer="2" name="hc_gauge,hc2_dark_body" storage="&'hc/ga2/hfb83174c8739_fill_dark_body.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.dark_body.left)" top="&String(tf.ga2_g.dark_body.top)" width="&String(tf.ga2_g.dark_body.width)" height="&String(tf.ga2_g.dark_body.height)" zindex="233"]
[image layer="2" name="hc_gauge,hc2_dark_left" storage="&'hc/ga2/hfe948c9fd944_fill_dark_left.png?ga2='+String(++tf.ga2_seq)" time="0" left="&String(tf.ga2_g.dark_left.left)" top="&String(tf.ga2_g.dark_left.top)" width="&String(tf.ga2_g.dark_left.width)" height="&String(tf.ga2_g.dark_left.height)" zindex="233"]
